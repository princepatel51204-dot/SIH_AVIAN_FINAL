.venv/
__pycache__/
*.pyc
*.blend1

# The REV-C scene is a build output, not a source artifact: 65 MB per stage
# of near-duplicate binary that would make each stage's diff unreviewable.
# It regenerates deterministically (frozen SEED, V22 0.00 mm drift) in about
# 3 minutes via build_scene_c.py. The renders and stats beside it ARE
# tracked -- they are the gate evidence. REV-B's own .blend stays tracked
# because it arrived as a delivered artifact rather than being generated here.
AVIAN_ENVIRONMENT/scene/*.blend

# Phase A -> Phase B handoff, and the visibility cache. Both are derived
# intermediates that regenerate from a build; neither is gate evidence.
# The cache is keyed on defect identity AND a scene-geometry fingerprint,
# so committing it would only invite someone to trust a stale answer.
AVIAN_ENVIRONMENT/scene/_handoff_phase_a.json
AVIAN_ENVIRONMENT/scene/vis_cache/

# shoot.sh scratch: generated camera worlds and raw frame dumps
AVIAN_ENVIRONMENT/gazebo/.shoot/

# SIH_AVIAN_FINAL -- same reasoning as AVIAN_ENVIRONMENT above: the .blend
# is a build output (deterministic SEED, regenerates in ~3 s via
# build_final.py + measure_final.py) and the handoff JSON is a derived
# intermediate. Renders, ground truth, stats, collision asset and the
# Gazebo world/models ARE tracked -- they are the gate evidence.
SIH_AVIAN_FINAL/scene/*.blend
SIH_AVIAN_FINAL/scene/*.blend1
SIH_AVIAN_FINAL/scene/_handoff_final.json
SIH_AVIAN_FINAL/gazebo/.shoot/

# Detection dataset raw render dump (798 frames' images/depth/normals/masks,
# 2.4 GB) -- same reasoning as the .blend exclusions above: a deterministic
# build output of dataset_render_final.py, not a source artifact, and at
# this size it would make the repo unreviewable rather than just noisy.
# The manifest/stats/negatives JSON+CSV and the build logs beside it ARE
# tracked -- they are the gate evidence (VD01-08 results, per-frame
# metadata), not the frames themselves.
SIH_AVIAN_FINAL/dataset/images/
SIH_AVIAN_FINAL/dataset/depth/
SIH_AVIAN_FINAL/dataset/normals/
SIH_AVIAN_FINAL/dataset/masks/
SIH_AVIAN_FINAL/dataset/samples/

# Phase 2 coverage-mission renders (82 PNGs, ~98 MB) -- regenerates
# deterministically via render_coverage_views_final.py from
# coverage_mission.json + coverage_mission_flight_log.json, both tracked.
# The trained detector weights are NOT excluded here: unlike these
# renders, they are the actual handover artifact, not an intermediate.
SIH_AVIAN_FINAL/detection/renders/

# Phase 2 Section 2 zoom-tile renders (1,167 PNGs) -- same reasoning:
# regenerates deterministically via render_zoom_tiles_final.py from
# coverage_mission.json + coverage_mission_flight_log.json (seed 20260925,
# both tracked). Both trained model weights (v1 and v2) stay tracked.
SIH_AVIAN_FINAL/detection/renders_zoom/

# Phase 2 Section 3 step 1: zoom tiles for ALL 82 settled waypoints
# (still rendering as of this commit) -- same reasoning, regenerates via
# render_zoom_tiles_all_final.py from the same tracked mission files.
SIH_AVIAN_FINAL/detection/renders_zoom_all/

# Phase A item 2 / Prompt 1 retry: external real-photo test dataset
# (Ozgenel "Concrete Crack Images for Classification", CC BY 4.0, ~230 MB) --
# downloaded on demand, never a source artifact, never committed.
SIH_AVIAN_FINAL/data/
