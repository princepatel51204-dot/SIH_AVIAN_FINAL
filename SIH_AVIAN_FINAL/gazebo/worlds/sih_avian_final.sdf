<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- SIH_AVIAN_FINAL corridor, x in [0, 360] of the Blender model. No world origin shift (see export_gazebo_final.py docstring). -->
  <world name="sih_avian_final">
    <physics name="default" type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin name="gz::sim::systems::physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::user_commands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::scene_broadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::contact" filename="gz-sim-contact-system"/>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>180 0 200 0 0 0</pose>
      <diffuse>0.9 0.88 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.9 -0.35</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>600 300</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>600 300</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.24 0.20 1</ambient>
            <diffuse>0.45 0.43 0.36 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>180 15 -1.3 0 0 0</pose>
    </model>
    <include>
      <uri>model://avian_final_road</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://avian_final_metro</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://avian_final_terrain</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://avian_final_defects</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>180 -260 170 0 0.6 1.5708</pose>
      </camera>
      <!-- view: whole corridor from above -> <pose>180 -260 170 0 0.6 1.5708</pose> -->
      <!-- view: river crossing from the water -> <pose>160 6 -1 0 -1.0 1.0</pose> -->
      <!-- view: inter-structure corridor -> <pose>150 15 15 0 0 0</pose> -->
    </gui>
  </world>
</sdf>
